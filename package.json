{
  "name": "3dados",
  "version": "0.7.0",
  "description": "Motor de rolagem de dados 3D para Virtual Tabletops (VTT), independente de framework.",
  "license": "MIT",
  "author": "Ramon Nascimento",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "assets"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "bench": "vitest run --project bench --silent=false"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
